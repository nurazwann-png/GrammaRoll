# Copy this file to .env and fill in your values. server.js loads .env automatically.

# Port the game server listens on
PORT=3000

# PIN teachers type to open Teacher Mode. Required in production (NODE_ENV=production).
# Without it, local development falls back to 1234.
TEACHER_PIN=change-me

# Optional: PostgreSQL connection. Leave unset to store classes and results in data/store.json.
# Matches docker-compose.yml (run: npm run db:up)
# DATABASE_URL=postgres://grammarball:grammarball@localhost:5432/grammarball

# Optional: human-sounding story narration (npm run narration). Set ONE provider.
# ElevenLabs (free tier, no card): https://elevenlabs.io → Profile → API keys
# ELEVENLABS_API_KEY=
# Azure Speech (free F0 tier): Azure portal → create "Speech" resource → Keys and Endpoint
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia

# Optional: where to keep the JSON store when no database is set
# DATA_FILE=./data/store.json
