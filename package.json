{
  "name": "grammar-roll-server",
  "version": "1.1.0",
  "description": "Grammar Roll Multiplayer Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')){fs.copyFileSync('.env.example','.env');console.log('Created .env from .env.example - edit TEACHER_PIN before sharing.')}else{console.log('.env already exists')}\"",
    "narration": "node scripts/generate-narration.js",
    "sfx": "node scripts/generate-sfx.js",
    "listening": "node scripts/generate-listening.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=18"
  }
}
